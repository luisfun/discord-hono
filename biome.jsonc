{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120,
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
    },
  },
  "linter": {
    "domains": {
      "qwik": "none",
    },
    "rules": {
      "preset": "all",
      "correctness": {
        "useImportExtensions": "off", // For simple coding purposes
      },
      "complexity": {
        "noBannedTypes": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "on",
          "options": {
            "maxAllowedComplexity": 20,
          },
        },
        "noExcessiveLinesPerFunction": "off", // Allow test functions with many lines
      },
      "nursery": {
        "useExplicitType": "warn", // Encourage explicit type annotation
      },
      "performance": {
        "noBarrelFile": "off", // For simple coding purposes
        "noReExportAll": "off", // For consistency in file separation
      },
      "style": {
        "noExcessiveLinesPerFile": "off", // For test files
        "noMagicNumbers": "off", // For lightweight coding
        "noNestedTernary": "off",
        "noTernary": "off",
        "useBlockStatements": "off", // Allow single-line statements without block braces
        "useConsistentMethodSignatures": "off", // Temporary
        "useDefaultSwitchClause": "off",
        "useDestructuring": "off", // For lightweight coding
        "useExportsLast": "off", // Allow exports to appear anywhere
        "useNamingConvention": "off",
        "useReadonlyClassProperties": "off", // Temporary
      },
      "suspicious": {
        "noBitwiseOperators": "off", // Use bitwise operations for high-speed processing
        "noConsole": {
          "level": "on",
          "options": {
            "allow": ["assert", "error", "info", "warn"],
          },
        },
        "noExplicitAny": "off", // Allow type any
        "noUnnecessaryConditions": "off", // Allow unnecessary conditions
      },
    },
  },
  "files": {
    "includes": [".github/**", "src/**", "bench/**", "*.ts", "*.md", "*.json", "*.jsonc"],
  },
}
