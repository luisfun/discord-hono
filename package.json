{
  "name": "discord-hono",
  "version": "0.22.0",
  "description": "This library enables you to easily build Discord bots on Cloudflare Workers",
  "author": "Luis (https://github.com/luisfun)",
  "repository": {
    "type": "git",
    "url": "https://github.com/luisfun/discord-hono"
  },
  "homepage": "https://github.com/luisfun/discord-hono",
  "license": "MIT",
  "keywords": [
    "discord-hono",
    "discord-bot",
    "cloudflare-workers"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "engines": {
    "node": ">=18.4.0"
  },
  "scripts": {
    "fix": "biome check --write .",
    "fix:unsafe": "biome check --write --unsafe .",
    "test": "biome check . && tsc && vitest run --coverage",
    "build": "tsdown src/index.ts --format esm --dts --clean && attw -P . --ignore-rules cjs-resolves-to-esm",
    "bench:only": "node --expose-gc bench/discord-hono.js",
    "bench:verify": "node --expose-gc bench/verify.js",
    "bench:json-factory": "node --expose-gc bench/json-factory.js",
    "bench": "npm run build && npm run bench:only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.4.16",
    "@discordjs/builders": "^1.14.1",
    "@tsconfig/strictest": "^2.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "discord-api-types": "^0.38.53",
    "discord-hono": "0.21.2",
    "hono": "^4.13.3",
    "mitata": "^1.0.34",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "discord-api-types": ">=0.38.0"
  },
  "peerDependenciesMeta": {
    "discord-api-types": {
      "optional": true
    }
  }
}
