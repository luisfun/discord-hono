{
  "name": "discord-hono",
  "version": "0.22.2",
  "description": "Discord bot framework built for the Edge",
  "keywords": [
    "cloudflare-workers",
    "discord-bot",
    "discord-hono"
  ],
  "homepage": "https://github.com/luisfun/discord-hono",
  "license": "MIT",
  "author": "Luis (https://github.com/luisfun)",
  "repository": {
    "type": "git",
    "url": "https://github.com/luisfun/discord-hono"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test run --coverage",
    "pack": "vp pack",
    "pack:test": "attw -P . -f table-flipped --ignore-rules cjs-resolves-to-esm",
    "build": "npm run check && npm run test && npm run pack && npm run pack:test",
    "bench:only": "node --expose-gc bench/discord-hono.js",
    "bench:verify": "node --expose-gc bench/verify.js",
    "bench:json-factory": "node --expose-gc bench/json-factory.js",
    "bench": "vp pack && npm run bench:only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@discordjs/builders": "^1.14.1",
    "@tsconfig/strictest": "^2.0.8",
    "@vitest/coverage-v8": "5.0.5",
    "discord-api-types": "^0.38.57",
    "discord-hono": "0.22.2",
    "hono": "^4.13.13",
    "mitata": "^1.0.34",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0"
  },
  "peerDependencies": {
    "discord-api-types": ">=0.38.0",
    "hono": ">=4.x"
  },
  "peerDependenciesMeta": {
    "discord-api-types": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.4.0"
  }
}
